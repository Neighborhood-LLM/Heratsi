# Local backend (server/) — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional: port the local backend listens on (defaults to 8787)
PORT=8787

# Optional: only needed if you deploy the frontend and backend separately
# (e.g. backend on a different host/port than the Vite dev server proxy).
# Leave unset for local dev — the Vite proxy handles it.
# VITE_API_URL=http://localhost:8787
